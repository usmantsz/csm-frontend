# =============================================================================
# COMMISSION SHOP FRONTEND – Environment (Local vs Live)
# =============================================================================
# Copy to .env and keep ONLY ONE block active (uncomment that block, comment the other).
# Switch: Local pe kaam karte waqt LOCAL block use karo; build for upload / live test ke liye LIVE block.
# =============================================================================

# ---------- LOCAL (development) – Apne PC par backend + frontend dono chalate waqt ----------
VITE_API_BASE_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000/api

# ---------- LIVE (production) – Railway/Render backend URL (see LIVE-SETUP.md) ----------
# VITE_API_BASE_URL=https://YOUR-BACKEND.up.railway.app
# VITE_API_URL=https://YOUR-BACKEND.up.railway.app/api
# On Vercel: add same keys in Project → Settings → Environment Variables

# ---------- Common (optional) ----------
VITE_APP_NAME=Commission Shop Management System
VITE_APP_VERSION=1.0.0
