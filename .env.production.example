# Production build – copy values to Vercel Environment Variables
# OR create .env.production locally before: npm run build

# Backend URL (no trailing slash) – from Railway or Render after deploy
VITE_API_BASE_URL=https://YOUR-BACKEND-URL.up.railway.app
VITE_API_URL=https://YOUR-BACKEND-URL.up.railway.app/api

VITE_APP_NAME=Commission Shop Management System
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=production
